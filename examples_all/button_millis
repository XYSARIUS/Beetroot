#include <Arduino.h>

constexpr uint8_t BUTTON_PIN = 20;
constexpr uint32_t DEBOUNCE_MS = 30;
bool previousHigh = true;
bool acceptedHigh = true;
uint32_t changedAt = 0;
uint32_t pressCount = 0;

void setup()
{
    Serial.begin(115200);
    pinMode(BUTTON_PIN, INPUT_PULLUP);
    previousHigh = digitalRead(BUTTON_PIN) == HIGH;
    acceptedHigh = previousHigh;
    changedAt = millis();
}

void loop()
{
    const bool high = digitalRead(BUTTON_PIN) == HIGH;
    const uint32_t now = millis();
    if (high != previousHigh)
    {
        previousHigh = high;
        changedAt = now;
    }
    if (high != acceptedHigh && uint32_t(now - changedAt) >= DEBOUNCE_MS)
    {
        acceptedHigh = high;
        if (!acceptedHigh)
        {
            ++pressCount;
            Serial.print("Press count: ");
            Serial.println(pressCount);
        }
    }
}