#include <Arduino.h>

volatile bool buttonPressed = false;

void IRAM_ATTR buttonISR() {
    buttonPressed = true;
}

enum class LedState {
    OFF,
    ON
};

enum class LedMode {
    Blinking,
    ON,
    OFF
};

struct LedConfig {
    static constexpr uint8_t PIN = 5;
    static constexpr uint8_t BUTTON_PIN = 6;
    static constexpr uint32_t BLINK_INTERVAL_MS = 100;
    static constexpr uint32_t DEBOUNCE_MS = 250;
};

class Led {
public:
    explicit Led(uint8_t pin) : pin_(pin) {}

    void init(){
        pinMode(pin_, OUTPUT);
    }
    void set(LedState state){
        digitalWrite(pin_, state == LedState::ON ? HIGH : LOW);
    }
private:
    uint8_t pin_;
};

Led& getLed() {
    static Led led(LedConfig::PIN);
    return led;
}

void setup() {
    getLed().init();
    pinMode(LedConfig::BUTTON_PIN, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(LedConfig::BUTTON_PIN), buttonISR, FALLING);
}

void loop() {
    static uint32_t previous_millis = 0;
    static uint32_t lastButtonTime = 0;
    static LedState state = LedState::OFF;
    static LedMode mode = LedMode::Blinking;
    LedMode iter_start_mode = mode;
    if (buttonPressed){
        buttonPressed = false;
        if (millis() - lastButtonTime >= LedConfig::DEBOUNCE_MS){
            lastButtonTime = millis();
            switch (mode) {
                case LedMode::Blinking:
                    mode = LedMode::ON;
                    break;
                case LedMode::ON:
                    mode = LedMode::OFF;
                    break;
                case LedMode::OFF:
                    mode = LedMode::Blinking;
                    previous_millis = millis();
                    break;
            }
        }        
    }
    if (mode == LedMode::ON && iter_start_mode != mode){
        state = LedState::ON;
        getLed().set(state);
    } else if (mode == LedMode::OFF && iter_start_mode != mode){
        state = LedState::OFF;
        getLed().set(state);
    } else if (mode == LedMode::Blinking && millis()-previous_millis >= LedConfig::BLINK_INTERVAL_MS){
        previous_millis += LedConfig::BLINK_INTERVAL_MS;
        state = (state == LedState::ON) ? LedState::OFF : LedState::ON;
        getLed().set(state);
    }
}
