#include <Arduino.h>

// Визначення пінів (constants для ясності коду)

#define LED_PIN 16
#define BUTTON_PIN 17

void setup() {
    // Ініціалізація послідовного інтерфейсу для відладки
    Serial.begin(115200);
    delay(1000);  // Очікування стабілізації Serial

    // Налаштування GPIO
    pinMode(LED_PIN, OUTPUT);
    pinMode(BUTTON_PIN, INPUT_PULLUP);
    Serial.println("GPIO система ініціалізована");
}

void loop() {
    // Зчитування стану кнопки
    int buttonState = digitalRead(BUTTON_PIN);

    // Логіка керування
    if (buttonState == LOW) {  // Кнопка натиснута
        digitalWrite(LED_PIN, HIGH);
        Serial.println("Кнопка натиснута - LED увімкнена");
    } else {  // Кнопка не натиснута
        digitalWrite(LED_PIN, LOW);
        Serial.println("Кнопка звільнена - LED вимкнена");
    }

    // Затримка 50 мс
    delay(50);
}