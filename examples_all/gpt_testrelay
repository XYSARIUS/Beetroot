
#include <Arduino.h>

// ==================== НАЛАШТУВАННЯ ====================

constexpr uint8_t RELAY_PIN = 5;
constexpr uint8_t CONTACT_PIN = 6;

constexpr uint8_t MEASUREMENTS = 10;

constexpr uint32_t TIMEOUT_MS = 2000;
constexpr uint32_t DEBOUNCE_MS = 40;

// Для більшості модулів реле потрібно перевірити,
// чи активний рівень HIGH або LOW.
constexpr uint8_t RELAY_ON = HIGH;
constexpr uint8_t RELAY_OFF = LOW;

// ==================== ЗМІННІ ISR ====================

volatile bool waitingForEdge = false;
volatile bool measurementDone = false;

volatile uint8_t expectedLevel = HIGH;

volatile uint32_t startTimeUs = 0;
volatile uint32_t elapsedTimeUs = 0;

// ==================== ПЕРЕРИВАННЯ ====================

void IRAM_ATTR contactISR() {
    if (!waitingForEdge) {
        return;
    }

    uint8_t level = digitalRead(CONTACT_PIN);

    // Реагуємо лише на очікуваний стан контакту.
    if (level == expectedLevel) {
        elapsedTimeUs = micros() - startTimeUs;
        measurementDone = true;
        waitingForEdge = false;
    }
}

// ==================== ОДНЕ ВИМІРЮВАННЯ ====================

bool measureRelay(bool turnOn, uint32_t &resultUs) {
    const uint8_t targetLevel = turnOn ? LOW : HIGH;
    const uint8_t relayLevel = turnOn ? RELAY_ON : RELAY_OFF;

    // Даємо контактам стабілізуватися.
    delay(DEBOUNCE_MS);

    // Перевіряємо, що контакт ще не перебуває
    // в очікуваному кінцевому стані.
    if (digitalRead(CONTACT_PIN) == targetLevel) {
        Serial.println(
            "ПОМИЛКА: контакт у неправильному початковому стані!"
        );
        return false;
    }

    // Готуємо вимірювання.
    noInterrupts();

    expectedLevel = targetLevel;
    measurementDone = false;
    waitingForEdge = true;

    startTimeUs = micros();

    interrupts();

    // Подаємо команду реле.
    digitalWrite(RELAY_PIN, relayLevel);

    const uint32_t waitStartMs = millis();

    // Очікуємо завершення вимірювання або тайм-аут.
    while (!measurementDone) {
        if (millis() - waitStartMs >= TIMEOUT_MS) {
            noInterrupts();
            waitingForEdge = false;
            interrupts();

            Serial.println(
                "ПОМИЛКА: тайм-аут очікування контакту!"
            );

            return false;
        }

        yield();
    }

    // Безпечно копіюємо результат.
    noInterrupts();
    resultUs = elapsedTimeUs;
    interrupts();

    // Очікуємо завершення брязкоту.
    delay(DEBOUNCE_MS);

    return true;
}

// ==================== СЕРІЯ ВИМІРЮВАНЬ ====================

void runMeasurements() {
    uint64_t totalOnUs = 0;
    uint64_t totalOffUs = 0;

    uint8_t successfulOn = 0;
    uint8_t successfulOff = 0;

    Serial.println();
    Serial.println("========== ВИМІРЮВАННЯ РЕЛЕ ==========");

    for (uint8_t i = 0; i < MEASUREMENTS; i++) {
        uint32_t onUs = 0;
        uint32_t offUs = 0;

        Serial.printf("\nЦикл %u:\n", i + 1);

        // Увімкнення.
        if (!measureRelay(true, onUs)) {
            Serial.println("Увімкнення не виміряно.");
            continue;
        }

        Serial.printf(
            "Увімкнення: %lu мкс (%.3f мс)\n",
            (unsigned long)onUs,
            onUs / 1000.0
        );

        totalOnUs += onUs;
        successfulOn++;

        // Вимкнення.
        if (!measureRelay(false, offUs)) {
            Serial.println("Вимкнення не виміряно.");
            continue;
        }

        Serial.printf(
            "Вимкнення: %lu мкс (%.3f мс)\n",
            (unsigned long)offUs,
            offUs / 1000.0
        );

        totalOffUs += offUs;
        successfulOff++;

        delay(200);
    }

    // ==================== ПІДСУМКИ ====================

    Serial.println();
    Serial.println("========== РЕЗУЛЬТАТИ ==========");

    Serial.printf(
        "Успішних вимірювань увімкнення: %u/%u\n",
        successfulOn,
        MEASUREMENTS
    );

    if (successfulOn > 0) {
        const double averageOnMs =
            (double)totalOnUs / successfulOn / 1000.0;

        Serial.printf(
            "Середній час увімкнення: %.3f мс\n",
            averageOnMs
        );
    }

    Serial.printf(
        "Успішних вимірювань вимкнення: %u/%u\n",
        successfulOff,
        MEASUREMENTS
    );

    if (successfulOff > 0) {
        const double averageOffMs =
            (double)totalOffUs / successfulOff / 1000.0;

        Serial.printf(
            "Середній час вимкнення: %.3f мс\n",
            averageOffMs
        );
    }

    Serial.println("=================================");
}

// ==================== SETUP ====================

void setup() {
    Serial.begin(115200);

    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, RELAY_OFF);

    pinMode(CONTACT_PIN, INPUT_PULLUP);

    delay(500);

    Serial.println();
    Serial.println("Вимірювання часу спрацювання реле");
    Serial.println("ESP32-S3 | Serial 115200");

    // Для початку реле має бути вимкнене,
    // а контакт COM-NO — розімкнений.
    if (digitalRead(CONTACT_PIN) != HIGH) {
        Serial.println(
            "ПОМИЛКА: контакт замкнений при старті!"
        );
        Serial.println(
            "Перевірте підключення COM, NO та GND."
        );
        return;
    }

    attachInterrupt(
        digitalPinToInterrupt(CONTACT_PIN),
        contactISR,
        CHANGE
    );

    runMeasurements();

    // Після завершення залишаємо реле вимкненим.
    digitalWrite(RELAY_PIN, RELAY_OFF);

    Serial.println();
    Serial.println("Вимірювання завершено.");
}

// ==================== LOOP ====================

void loop() {
    // Вимірювання запускаються один раз у setup().
}