#include <Arduino.h>

constexpr uint8_t LED_RED = 15;
constexpr uint8_t LED_GREEN = 16;
constexpr uint8_t BUTTON_EXT = 21;
constexpr uint8_t BUTTON_INT = 0;
static bool mode = 0;


void mode1() {
  digitalWrite(LED_RED, HIGH);
  digitalWrite(LED_GREEN, HIGH);
  delay(200);
  digitalWrite(LED_RED, LOW);
  digitalWrite(LED_GREEN, LOW);
  delay(200);
}

void mode2() {
  digitalWrite(LED_RED, HIGH);
  digitalWrite(LED_GREEN, LOW);
  delay(1000);
  digitalWrite(LED_RED, LOW);
  digitalWrite(LED_GREEN, HIGH);
  delay(1000);
}
void setup() {
  Serial.begin(115200);
  delay(1000);
  pinMode(LED_RED, OUTPUT);
  pinMode(LED_GREEN, OUTPUT);
  pinMode(BUTTON_EXT, INPUT_PULLUP);
  pinMode(BUTTON_INT, INPUT);
  Serial.println("GPIO система ініціалізована");
}

void loop() {

  if (!digitalRead(BUTTON_EXT)) {
    mode = 0;
    Serial.println("Режим 1");   
  }
  if (!digitalRead(BUTTON_INT)) {
    mode = 1;
    Serial.println("Режим 2");
  }
  if (!mode){
    mode1();
  } else {
    mode2();
  }
}

