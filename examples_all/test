#include <Arduino.h>

constexpr uint8_t RELAY_PIN = 5, READ_PIN = 6, DEBOUNCE_MS = 1000, MEASURMENTS = 10;

volatile uint32_t startTimeUs = 0;
volatile uint32_t finishTimeUs = 0;
volatile bool RELAYSTATE = false;

void IRAM_ATTR relayPin() {
    startTimeUs = micros(); 
}

void IRAM_ATTR readPin() {
    finishTimeUs = micros();
}

void setup() {
    Serial.begin(115200);
    delay(1000);
    pinMode(RELAY_PIN, OUTPUT);
    digitalWrite(RELAY_PIN, HIGH);
    pinMode(READ_PIN, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(RELAY_PIN), relayPin, FALLING);
    attachInterrupt(digitalPinToInterrupt(READ_PIN), readPin, FALLING);
}

void loop() {
    static uint32_t totalElapsedTimeUs = 0;
    static uint32_t count = 0;
    
    digitalWrite(RELAY_PIN, !digitalRead(RELAY_PIN));
    delay(DEBOUNCE_MS);

    if (startTimeUs != 0 && finishTimeUs != 0 && count < MEASURMENTS) {
        uint32_t elapsedTimeUs = finishTimeUs - startTimeUs;
        totalElapsedTimeUs += elapsedTimeUs;
        count++;
        Serial.print("Elapsed time: ");
        Serial.print(elapsedTimeUs);
        Serial.println(" us");
        startTimeUs = 0;
        finishTimeUs = 0;
    }

    if (count >= MEASURMENTS) {
        uint32_t averageElapsedTimeUs = totalElapsedTimeUs / MEASURMENTS;
        Serial.print("Average elapsed time over ");
        Serial.print(MEASURMENTS);
        Serial.print(" measurements: ");
        Serial.print(averageElapsedTimeUs/1000.0);
        Serial.println(" us");
        count = 0;
        totalElapsedTimeUs = 0;
    }

}
