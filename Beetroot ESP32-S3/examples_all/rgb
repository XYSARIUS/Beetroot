#include <Arduino.h>

#include <Adafruit_NeoPixel.h>

constexpr uint8_t RGB_LED_PIN = 48;
constexpr uint8_t RGB_LED_COUNT = 1;
constexpr uint8_t RGB_LED_BRIGHTNESS = 64;

Adafruit_NeoPixel rgbLed(RGB_LED_COUNT, RGB_LED_PIN, NEO_GRB + NEO_KHZ800);

void setup() {
  rgbLed.begin();
  rgbLed.setBrightness(RGB_LED_BRIGHTNESS);
  rgbLed.show();
}

void loop() {
  static uint16_t hue = 0;

  rgbLed.setPixelColor(0, rgbLed.ColorHSV(hue));
  rgbLed.show();

  hue += 128;
  delay(10);
}