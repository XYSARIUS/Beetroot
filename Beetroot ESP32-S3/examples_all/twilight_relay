#include <Arduino.h>

constexpr uint8_t LDR_PIN = 5;
constexpr uint8_t RELAY_PIN = 4;
constexpr uint32_t ADC_READ_MS = 100;
constexpr uint32_t BAUD_RATE = 115200;
constexpr uint32_t TRESHOLD_DARK = 1250;
constexpr uint32_t TRESHOLD_LIGHT = 2750;

int ldrValue = 0;
bool lightstate = true;

void setup(){
  Serial.begin(BAUD_RATE);
  pinMode(LDR_PIN, INPUT);
  pinMode(RELAY_PIN, OUTPUT);
}

void loop(){
  if (millis() % ADC_READ_MS == 0 && analogRead(LDR_PIN) != 0){
    ldrValue = analogRead(LDR_PIN);
    if (ldrValue <= TRESHOLD_DARK && !lightstate) {
      lightstate = true;
      digitalWrite(RELAY_PIN, HIGH);
      Serial.printf("LDR value: %d, turn ON\n", ldrValue);
    }
    if (ldrValue >= TRESHOLD_LIGHT && lightstate) {
      lightstate = false;
      digitalWrite(RELAY_PIN, LOW);
      Serial.printf("LDR value: %d, turn OFF\n", ldrValue);
    }
  }
}